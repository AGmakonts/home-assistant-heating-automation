# Example Home Assistant configuration.yaml snippet
# Add these lines to your configuration.yaml

# Enable Python scripts
python_script:

# Include automation configuration
# Option 1: Include the entire automations file
automation: !include automations/heating_automations.yaml

# Option 2: If you already have automations, merge them
# automation manual: !include_dir_merge_list automations/

# Include input helpers
# Option 1: Include directly
input_text: !include input_helpers.yaml
input_boolean: !include input_helpers.yaml
input_number: !include input_helpers.yaml
input_datetime: !include input_helpers.yaml

# Option 2: If you already have input helpers, you can merge
# Or manually copy the contents of input_helpers.yaml into your configuration.yaml

# Enable logbook for heating system events
logbook:
  include:
    domains:
      - switch
      - climate
    entities:
      - switch.sonoff_10017fadeb
      - input_button.wylacznik_pompy

# Optional: Create a custom panel/view for heating management
# This is just an example of how you might organize the UI

